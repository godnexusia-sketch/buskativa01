DATABASE_URL=postgres://buskativa:buskativa@localhost:5432/buskativa
# TLS do Postgres: disable | require (criptografa, não verifica o certificado) | verify (exige DATABASE_CA_CERT).
# Vazio = require para host remoto e disable para localhost. Parâmetros ssl* da DATABASE_URL são ignorados.
DATABASE_SSL=
# Certificado da CA em PEM (só para DATABASE_SSL=verify; "\n" literal é aceito)
DATABASE_CA_CERT=
# Conexões máximas do pool por processo (web e worker); padrão 5
DB_POOL_MAX=5
REDIS_URL=redis://localhost:6379
# "demo" usa lojas falsas (desenvolvimento/E2E); vazio usa as lojas reais
CONNECTORS=demo
ML_ACCESS_TOKEN=
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
KWAI_ENABLED=false
SEARCH_INTERVAL_MIN=60
SEARCH_FAST_INTERVAL_MIN=30
WORKER_CONCURRENCY=1
# Páginas do Chromium abertas ao mesmo tempo, somando todas as lojas (padrão 1)
BROWSER_MAX_CONTEXTS=1
# Se definida (o Render injeta), o worker abre um health check HTTP em / e /healthz nessa porta
# PORT=10000
# Parâmetros de afiliado por loja, no formato query string
AFFILIATE_PARAMS_AMAZON=tag=seutag-20
AFFILIATE_PARAMS_MERCADOLIVRE=
AFFILIATE_PARAMS_SHOPEE=
AFFILIATE_PARAMS_MAGALU=
AFFILIATE_PARAMS_ALIEXPRESS=
# Token (Bearer) das rotas /api/admin/*; sem ele elas respondem 503. Gere um valor longo e aleatório.
ADMIN_TOKEN=
# Sal do hash de IP dos votos de cupom; sem ele a votação responde 503.
VOTE_SALT=
# Opcional: cabeçalho com o IP real definido pela sua CDN (ex.: cf-connecting-ip). Vazio = só x-forwarded-for.
TRUSTED_IP_HEADER=
# Checagem de deploy: "true" registra uma vez por processo os cabeçalhos de IP crus da primeira busca. Desligue depois.
LOG_CLIENT_IP_HEADERS=

# Google (todas opcionais; sem a variável, nada é carregado)
# URL canônica do site (sitemap, robots, metadata); vazio = http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# GA4, formato G-XXXXXXXX (o script carrega com tudo negado; cookies de medição só após aceitar)
NEXT_PUBLIC_GA_ID=
# AdSense, formato ca-pub-XXXXXXXXXXXXXXXX; também gera /ads.txt
NEXT_PUBLIC_ADSENSE_CLIENT=
# IDs numéricos dos blocos de anúncio
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=
NEXT_PUBLIC_ADSENSE_SLOT_PRODUCT=
# Código de verificação do Search Console (meta google-site-verification)
GOOGLE_SITE_VERIFICATION=
# Nome do controlador de dados (LGPD) exibido em /privacidade; vazio = "Responsável pelo BUSKATIVA"
NEXT_PUBLIC_CONTROLLER_NAME=
# E-mail exibido em /contato e /privacidade; vazio = godnexus.ia@gmail.com
NEXT_PUBLIC_CONTACT_EMAIL=
