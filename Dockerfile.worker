FROM node:24-slim
WORKDIR /app
COPY . .
# tsx (devDependency) executa o worker em TypeScript, então as dependências de desenvolvimento ficam.
# O Chromium e suas bibliotecas de sistema vêm do próprio Playwright.
RUN npm ci --include=dev && npx playwright install --with-deps chromium
ENV NODE_ENV=production
# O Render injeta PORT; o worker abre /healthz nela. --env-file-if-exists ignora o .env ausente (excluído pelo .dockerignore).
CMD ["npm", "run", "start", "-w", "@buskativa/worker"]
