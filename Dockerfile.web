FROM node:24-slim AS build
WORKDIR /app
# NEXT_PUBLIC_* são embutidas no bundle no build do Next; o Render repassa as variáveis do serviço como build args.
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_GA_ID
ARG NEXT_PUBLIC_ADSENSE_CLIENT
ARG NEXT_PUBLIC_ADSENSE_SLOT_HOME
ARG NEXT_PUBLIC_ADSENSE_SLOT_RESULTS
ARG NEXT_PUBLIC_ADSENSE_SLOT_PRODUCT
ARG NEXT_PUBLIC_CONTACT_EMAIL
ARG NEXT_PUBLIC_CONTROLLER_NAME
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_GA_ID=$NEXT_PUBLIC_GA_ID \
    NEXT_PUBLIC_ADSENSE_CLIENT=$NEXT_PUBLIC_ADSENSE_CLIENT \
    NEXT_PUBLIC_ADSENSE_SLOT_HOME=$NEXT_PUBLIC_ADSENSE_SLOT_HOME \
    NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=$NEXT_PUBLIC_ADSENSE_SLOT_RESULTS \
    NEXT_PUBLIC_ADSENSE_SLOT_PRODUCT=$NEXT_PUBLIC_ADSENSE_SLOT_PRODUCT \
    NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL \
    NEXT_PUBLIC_CONTROLLER_NAME=$NEXT_PUBLIC_CONTROLLER_NAME
COPY . .
RUN npm ci --include=dev && npm run build -w @buskativa/web

FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
